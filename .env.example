# OpenRouter: no .env key needed — the student pastes their key in-app
# (Settings tab → AI Engine) and picks any free model from the live list.
# Without a key, every tutor answers from the built-in offline engine.

# GOOGLE_WEB_CLIENT_ID: Web OAuth Client ID for Google Sign-In (Credential Manager).
# Create one in Google Cloud Console (APIs & Services > Credentials > OAuth client ID,
# type "Web application"). Without it, the in-app Google sign-in button shows a
# "not configured" message instead of opening the Google account picker.
GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID

# NOORIX_SYNC_BASE_URL: learning-event sync endpoint. No server exists yet;
# the .example default is intentionally unroutable so uploads fail fast and
# honestly (queue stays pending) until the endpoint ships.
NOORIX_SYNC_BASE_URL=https://sync.noorix.example/v1
